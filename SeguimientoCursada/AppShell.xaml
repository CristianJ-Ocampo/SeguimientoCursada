<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SeguimientoCursada.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:SeguimientoCursada.Pages"
    xmlns:viewModels="clr-namespace:SeguimientoCursada.ViewModels"
    x:DataType="viewModels:AppShellViewModel"
    Title="SeguimientoCursada">

    <Shell.FlyoutHeader>
        <Grid Padding="16" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <Label Text="Preferencias de apariencia"
                   FontAttributes="Bold" />
            <Label Grid.Row="1"
                   Text="Modo oscuro"
                   VerticalOptions="Center" />
            <Switch Grid.Column="1"
                    Grid.Row="1"
                    IsToggled="{Binding TemaOscuro, Mode=TwoWay}"
                    VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate pages:InicioPage}"
        Route="InicioPage" />

    <ShellContent
        Title="Estudiantes"
        ContentTemplate="{DataTemplate pages:EstudiantesPage}"
        Route="EstudiantesPage" />

    <ShellContent
        Title="Asistencia"
        ContentTemplate="{DataTemplate pages:AsistenciaPage}"
        Route="AsistenciaPage" />

    <ShellContent
        Title="Calendario de clases"
        ContentTemplate="{DataTemplate pages:CalendarioClasesPage}"
        Route="CalendarioClasesPage" />

    <ShellContent
        Title="Trabajos prácticos"
        ContentTemplate="{DataTemplate pages:TrabajosPracticosPage}"
        Route="TrabajosPracticosPage" />

    <ShellContent
        Title="Panel de riesgo"
        ContentTemplate="{DataTemplate pages:PanelRiesgoPage}"
        Route="PanelRiesgoPage" />

    <ShellContent
        Title="Configuración"
        ContentTemplate="{DataTemplate pages:ConfiguracionPage}"
        Route="ConfiguracionPage" />

</Shell>
