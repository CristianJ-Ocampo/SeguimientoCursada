<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SeguimientoCursada.ViewModels"
             xmlns:models="clr-namespace:SeguimientoCursada.Models"
             x:Class="SeguimientoCursada.Pages.EstudiantesPage"
             x:Name="EstudiantesPageRoot"
             x:DataType="viewModels:EstudiantesViewModel"
             Title="Estudiantes">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
            <Label Text="Alta de estudiantes"
                   Grid.Row="0"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Entry Placeholder="Legajo"
                   Grid.Row="1"
                   Text="{Binding InputLegajo}"
                   Keyboard="Numeric" />
            <Entry Placeholder="Apellido"
                   Grid.Row="2"
                   Text="{Binding Apellido}" />
            <Entry Placeholder="Nombre"
                   Grid.Row="3"
                   Text="{Binding Nombre}" />

            <Picker Grid.Row="4"
                    Title="Seleccioná una comisión"
                    ItemsSource="{Binding Comisiones}"
                    SelectedItem="{Binding ComisionSeleccionada}" />

            <Button Text="Agregar estudiante"
                    Grid.Row="5"
                    Command="{Binding AgregarEstudianteCommand}"
                    HorizontalOptions="Fill" />

            <Label Text="{Binding MensajeValidacion}"
                   TextColor="Red"
                   Grid.Row="6" />

            <Grid Grid.Row="7" RowDefinitions="Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nómina de estudiantes"
                           Style="{StaticResource SubHeadline}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Grid.Column="1"
                           Text="{Binding CantidadEstudiantes, StringFormat='Total: {0}'}"
                           VerticalOptions="Center" />
                </Grid>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding EstudiantesFiltrados}"
                                EmptyView="{Binding MensajeNominaVacia}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Estudiante">
                            <Border Stroke="LightGray"
                                    StrokeThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto"
                                      RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Legajo:" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Legajo}" Margin="8,0,16,0" />
                                    <Label Grid.Row="0" Grid.Column="2" Text="Comisión:" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="3" Text="{Binding Comision}" Margin="8,0,0,0" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Apellido}" Margin="8,0,16,0" />
                                    <Label Grid.Row="1" Grid.Column="2" Text="Nombre:" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Grid.Column="3" Text="{Binding Nombre}" Margin="8,0,0,0" />
                                    <Button Grid.RowSpan="2"
                                            Grid.Column="4"
                                            Text="Ver ficha"
                                            Command="{Binding Source={x:Reference EstudiantesPageRoot}, Path=BindingContext.AbrirDetalleCommand}"
                                            CommandParameter="{Binding Legajo}"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
    </Grid>
</ContentPage>
