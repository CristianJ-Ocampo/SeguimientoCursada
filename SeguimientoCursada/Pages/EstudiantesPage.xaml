<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:SeguimientoCursada.ViewModels"
             xmlns:models="clr-namespace:SeguimientoCursada.Models"
             x:Class="SeguimientoCursada.Pages.EstudiantesPage"
             x:Name="EstudiantesPageRoot"
             x:DataType="viewModels:EstudiantesViewModel"
             Title="Estudiantes">
    <Grid Padding="24"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="Nómina de estudiantes"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Grid.Column="1"
                   Text="{Binding CantidadEstudiantes, StringFormat='Total: {0}'}"
                   VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Picker Title="Seleccioná una comisión"
                    ItemsSource="{Binding Comisiones}"
                    SelectedItem="{Binding ComisionSeleccionada}"
                    VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Alta de estudiantes"
                    Command="{Binding IrAlAltaCommand}" />
        </Grid>

        <Label Grid.Row="2"
               Text="{Binding MensajeError}"
               TextColor="Red"
               IsVisible="{Binding TieneMensajeError}" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding EstudiantesFiltrados}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24"
                                     Spacing="12"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Source={x:Reference EstudiantesPageRoot}, Path=BindingContext.MensajeNominaVacia}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Registrar primer alumno"
                            Command="{Binding Source={x:Reference EstudiantesPageRoot}, Path=BindingContext.IrAlAltaCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:EstudianteListadoViewModel">
                    <Border Stroke="LightGray"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto"
                              RowDefinitions="Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="Legajo:" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Legajo}" Margin="8,0,16,0" />
                            <Label Grid.Row="0" Grid.Column="2" Text="Comisión:" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="3" Text="{Binding Comision}" Margin="8,0,0,0" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Apellido}" Margin="8,0,16,0" />
                            <Label Grid.Row="1" Grid.Column="2" Text="Nombre:" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="3" Text="{Binding Nombre}" Margin="8,0,0,0" />
                            <Label Grid.Row="2" Grid.ColumnSpan="4"
                                   Text="{Binding TextoSeguimiento}"
                                   TextColor="{Binding ColorSeguimiento}"
                                   FontAttributes="Bold"
                                   Margin="0,8,0,0"
                                   IsVisible="{Binding PuedeMostrarSeguimiento}" />
                            <Button Grid.RowSpan="3"
                                    Grid.Column="4"
                                    Text="Ver ficha"
                                    Command="{Binding Source={x:Reference EstudiantesPageRoot}, Path=BindingContext.AbrirDetalleCommand}"
                                    CommandParameter="{Binding Legajo}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
