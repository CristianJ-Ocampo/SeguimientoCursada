<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SeguimientoCursada.Models"
             xmlns:viewModels="clr-namespace:SeguimientoCursada.ViewModels"
             x:Class="SeguimientoCursada.Pages.EstudianteDetallePage"
             x:Name="DetallePageRoot"
             x:DataType="viewModels:EstudianteDetalleViewModel"
             Title="Ficha del estudiante">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Ficha del estudiante"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="16"
                    IsVisible="{Binding MostrarDatosLectura}">
                <Grid ColumnDefinitions="Auto,*"
                       RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <Label Grid.Row="0" Text="Apellido:" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Apellido}" />
                    <Label Grid.Row="1" Text="Nombre:" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Nombre}" />
                    <Label Grid.Row="2" Text="Legajo:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Legajo}" />
                    <Label Grid.Row="3" Text="Comisión:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Comision}" />
                    <Label Grid.Row="4" Text="Ingreso:" FontAttributes="Bold" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding FechaIngresoTexto}" />
                    <Label Grid.Row="5" Text="Riesgo:" FontAttributes="Bold" />
                    <Label Grid.Row="5" Grid.Column="1"
                           Text="{Binding NivelRiesgo}"
                           FontAttributes="Bold"
                           TextColor="{Binding ColorNivelRiesgo}" />
                    <Label Grid.Row="6" Text="Detalle:" FontAttributes="Bold" />
                    <Label Grid.Row="6" Grid.Column="1" Text="{Binding MotivoRiesgo}" />
                </Grid>
            </Border>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="16"
                    IsVisible="{Binding Editando}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Editar datos del estudiante" FontAttributes="Bold" />
                    <Label Text="Legajo" />
                    <Entry Text="{Binding LegajoEditable}"
                           Keyboard="Numeric"
                           Placeholder="Legajo" />
                    <Label Text="Apellido" />
                    <Entry Text="{Binding ApellidoEditable}"
                           Placeholder="Apellido" />
                    <Label Text="Nombre" />
                    <Entry Text="{Binding NombreEditable}"
                           Placeholder="Nombre" />
                    <Label Text="Comisión" />
                    <Picker ItemsSource="{Binding Comisiones}"
                            SelectedItem="{Binding ComisionEditable}"
                            Title="Seleccioná una comisión" />
                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Guardar cambios"
                                Command="{Binding GuardarCambiosCommand}" />
                        <Button Text="Cancelar"
                                Command="{Binding CancelarEdicionCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="12"
                                   IsVisible="{Binding PuedeEditar}">
                <Button Text="Editar datos"
                        Command="{Binding EditarDatosCommand}" />
                <Button Text="Eliminar estudiante"
                        Command="{Binding EliminarEstudianteCommand}"
                        BackgroundColor="#B00020"
                        TextColor="White" />
            </HorizontalStackLayout>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Fecha de ingreso" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding CursaDesdeInicio}" />
                        <Label Text="Cursó desde el inicio"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding PrimeraFechaClaseTexto}"
                           IsVisible="{Binding CursaDesdeInicio}"
                           FontSize="12"
                           TextColor="Gray" />
                    <DatePicker Date="{Binding FechaIngresoSeleccionada}"
                                MaximumDate="{Binding FechaMaximaIngreso}"
                                Format="dd/MM/yyyy"
                                IsVisible="{Binding MostrarSelectorFechaIngreso}" />
                    <Button Text="Guardar fecha de ingreso"
                            Command="{Binding GuardarFechaIngresoCommand}" />
                    <Label Text="{Binding RegistrosAntesDelIngreso, StringFormat='Registros previos al ingreso (no computan): {0}'}"
                           TextColor="Gray"
                           IsVisible="{Binding TieneRegistrosAntesDelIngreso}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Clases registradas" FontAttributes="Bold" />
                        <Label Text="{Binding TotalClases}" FontSize="24" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="LightGray" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Inasistencias" FontAttributes="Bold" />
                        <Label Text="{Binding TotalInasistencias}" FontSize="24" TextColor="DarkRed" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Indicadores académicos"
                           FontAttributes="Bold" />
                    <Label Text="{Binding PorcentajeAsistencia, StringFormat='Asistencia: {0:0.##}%'}" />
                    <Label Text="{Binding TextoAusenciasSeguidas}"
                           IsVisible="{Binding MostrarAusenciasSeguidas}"
                           FontAttributes="Bold"
                           TextColor="DarkRed" />
                    <Label Text="{Binding ClasesAsistidas, StringFormat='Clases asistidas o justificadas: {0}'}" />
                    <Label Text="{Binding TotalClasesConfiguradas, StringFormat='Total de días de clase configurados: {0}'}" />
                    <Label Text="{Binding PorcentajeEntregas, StringFormat='Entregas de trabajos prácticos: {0:0.##}%'}" />
                    <Label Text="{Binding ResumenEntregas}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Historial de asistencia"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <CollectionView ItemsSource="{Binding Historial}"
                            HeightRequest="300"
                            EmptyView="No hay asistencias registradas para este estudiante.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AsistenciaHistorialViewModel">
                        <Grid Padding="12"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" />
                                <Label Text="Antes del ingreso"
                                       TextColor="Gray"
                                       FontSize="12"
                                       IsVisible="{Binding EsAnteriorAlIngreso}" />
                            </VerticalStackLayout>
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.EstadosAsistencia}"
                                    SelectedItem="{Binding EstadoSeleccionado}"
                                    Title="Estado"
                                    VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="Guardar"
                                    Command="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.ActualizarAsistenciaCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Completar registros faltantes"
                    Command="{Binding CompletarRegistrosCommand}" />

            <Label Text="Trabajos prácticos"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <CollectionView ItemsSource="{Binding TrabajosPracticos}"
                            HeightRequest="300"
                            SelectionMode="None"
                            EmptyView="No hay trabajos prácticos configurados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:EntregaTrabajoViewModel">
                        <Grid Padding="12"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="{Binding Titulo}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Descripcion}"
                                       IsVisible="{Binding TieneDescripcion}" />
                                <Label Text="{Binding VencimientoMostrado}"
                                       TextColor="Gray"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <Label Text="Entregado"
                                       VerticalOptions="Center" />
                                <CheckBox IsChecked="{Binding Entregado}"
                                          CheckedChanged="OnEntregaChanged" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Seguimiento de contacto"
                    IsVisible="{Binding PuedeRegistrarContacto}"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <Border Stroke="LightGray" StrokeThickness="1" Padding="12"
                    IsVisible="{Binding PuedeRegistrarContacto}">
                <VerticalStackLayout Spacing="8">
                    <DatePicker Date="{Binding FechaContacto}" />
                    <TimePicker Time="{Binding HoraContacto}" />
                    <Picker Title="Medio de contacto"
                            ItemsSource="{Binding MediosContacto}"
                            SelectedItem="{Binding MedioContacto}" />
                    <Picker Title="Motivo de contacto"
                            ItemsSource="{Binding MotivosContacto}"
                            SelectedItem="{Binding MotivoContacto}" />
                    <Editor Placeholder="Resultado u observaciones"
                            Text="{Binding ResultadoContacto}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80" />
                    <Button Text="Guardar Intervención"
                            Command="{Binding RegistrarContactoCommand}" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Contactos}"
                            IsVisible="{Binding PuedeRegistrarContacto}"
                            HeightRequest="260"
                            EmptyView="No hay contactos registrados para este estudiante.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ContactoHistorialViewModel">
                        <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="0,0,0,6">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding FechaHora, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Medio, StringFormat='Medio: {0}'}" />
                                <Label Text="{Binding Motivo, StringFormat='Motivo: {0}'}" />
                                <Label Text="{Binding Resultado}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding Mensaje}"
                   TextColor="Red" />
            <Button Text="Volver"
                    Command="{Binding VolverCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
