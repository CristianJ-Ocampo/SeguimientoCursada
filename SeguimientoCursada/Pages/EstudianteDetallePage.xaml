<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SeguimientoCursada.Models"
             xmlns:viewModels="clr-namespace:SeguimientoCursada.ViewModels"
             x:Class="SeguimientoCursada.Pages.EstudianteDetallePage"
             x:Name="DetallePageRoot"
             x:DataType="viewModels:EstudianteDetalleViewModel"
             Title="Ficha del estudiante">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Ficha del estudiante"
                   Style="{StaticResource Headline}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <Label Grid.Row="0" Text="Apellido:" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Apellido}" />
                    <Label Grid.Row="1" Text="Nombre:" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Nombre}" />
                    <Label Grid.Row="2" Text="Legajo:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Legajo}" />
                    <Label Grid.Row="3" Text="Comisión:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Comision}" />
                    <Label Grid.Row="4" Text="Riesgo:" FontAttributes="Bold" />
                    <Label Grid.Row="4" Grid.Column="1"
                           Text="{Binding NivelRiesgo}"
                           FontAttributes="Bold"
                           TextColor="{Binding ColorNivelRiesgo}" />
                    <Label Grid.Row="5" Text="Detalle:" FontAttributes="Bold" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding MotivoRiesgo}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Stroke="LightGray" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Clases registradas" FontAttributes="Bold" />
                        <Label Text="{Binding TotalClases}" FontSize="24" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="LightGray" StrokeThickness="1" Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Inasistencias" FontAttributes="Bold" />
                        <Label Text="{Binding TotalInasistencias}" FontSize="24" TextColor="DarkRed" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Stroke="LightGray"
                    StrokeThickness="1"
                    Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Indicadores académicos"
                           FontAttributes="Bold" />
                    <Label Text="{Binding PorcentajeAsistencia, StringFormat='Asistencia: {0:0.##}%'}" />
                    <Label Text="{Binding ClasesAsistidas, StringFormat='Clases asistidas o justificadas: {0}'}" />
                    <Label Text="{Binding TotalClasesConfiguradas, StringFormat='Total de días de clase configurados: {0}'}" />
                    <Label Text="{Binding PorcentajeEntregas, StringFormat='Entregas de TPs obligatorios: {0:0.##}%'}" />
                    <Label Text="{Binding TrabajosEntregados, StringFormat='TPs entregados: {0}'}" />
                    <Label Text="{Binding TotalTrabajosObligatorios, StringFormat='TPs obligatorios: {0}'}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Historial de asistencia"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <CollectionView ItemsSource="{Binding Historial}"
                            HeightRequest="300"
                            EmptyView="No hay asistencias registradas para este estudiante.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:AsistenciaHistorialViewModel">
                        <Grid Padding="12"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12">
                            <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                   VerticalOptions="Center" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.EstadosAsistencia}"
                                    SelectedItem="{Binding EstadoSeleccionado}"
                                    Title="Estado"
                                    VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="Guardar"
                                    Command="{Binding Source={x:Reference DetallePageRoot}, Path=BindingContext.ActualizarAsistenciaCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Trabajos prácticos obligatorios"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <CollectionView ItemsSource="{Binding TrabajosPracticos}"
                            HeightRequest="300"
                            SelectionMode="None"
                            EmptyView="No hay trabajos prácticos obligatorios configurados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:EntregaTrabajoViewModel">
                        <Grid Padding="12"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="{Binding Titulo}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Descripcion}"
                                       IsVisible="{Binding TieneDescripcion}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="8"
                                                   VerticalOptions="Center">
                                <Label Text="Entregado"
                                       VerticalOptions="Center" />
                                <CheckBox IsChecked="{Binding Entregado}"
                                          CheckedChanged="OnEntregaChanged" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding Mensaje}"
                   TextColor="Red" />
            <Button Text="Volver"
                    Command="{Binding VolverCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
